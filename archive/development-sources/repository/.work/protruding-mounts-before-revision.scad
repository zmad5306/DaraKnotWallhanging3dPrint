    if (i==1) photo_loop_2();
    if (i==2) photo_loop_3();
    if (i==3) photo_loop_4();
    if (i==4) photo_loop_5();
    if (i==5) photo_loop_6();
    if (i==6) photo_loop_7();
    if (i==7) photo_loop_8();
