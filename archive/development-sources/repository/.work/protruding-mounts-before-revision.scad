fabric_colour = [0.57, 0.49, 0.36];
letter_colour = [0.96, 0.91, 0.79];

/* [Hidden] */
master_width = 1219.2;
uniform_scale = overall_width / master_width;
// Front orthographic view on opening. Rotate normally to inspect the depth.
$vpt = view_mode=="mount_detail" ? [0,0,12] : [0,0,0];
$vpr = view_mode=="mount_detail" || view_mode=="washer" ? [65,0,25] : [0,0,0];
$vpd = view_mode=="section" ? 600 : view_mode=="joint_detail" || view_mode=="mount_detail" ? 220 : view_mode=="washer" ? 40 : view_mode=="fit_sample" || view_mode=="retainer" ? 100 : overall_width*2.75;
