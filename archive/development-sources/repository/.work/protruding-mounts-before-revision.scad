// Evaluate the rear CSG once so OpenSCAD F5 shows all rails reliably.
module photo_frame() {
    render(convexity=40) difference() {
        union() {
            knot_reference();
            print_core();
            for(i=[0:7],j=[0:3]) at_retainer(i,j) track_blank_mm();
