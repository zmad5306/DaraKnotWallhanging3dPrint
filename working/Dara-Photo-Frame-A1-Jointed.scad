$vpt = view_mode=="wall_keyhole_detail" ? [43.5,0,wall_standoff/2] : view_mode=="mount_detail" ? [0,0,12] : view_mode=="retainer_detail" ? [5,0,4] : view_mode=="layout" ? [560,-floor((part_count(part_family)-1)/5)*140,0] : [0,0,0];
$vpr = view_mode=="wall_keyhole_detail" ? [75,0,80] : view_mode=="wall_mount_detail" ? [120,0,20] : view_mode=="wall_block" || view_mode=="wall_blocks" || view_mode=="wall_fit_sample" ? [45,0,20] : view_mode=="retainer_detail" ? [110,0,205] : view_mode=="fit_sample" ? [45,0,20] : view_mode=="mount_detail" || view_mode=="washer" ? [65,0,25] : [0,0,0];
$vpd = view_mode=="wall_keyhole_detail" ? 120 : view_mode=="wall_block" || view_mode=="wall_mount_detail" || view_mode=="wall_keyhole_detail" ? 330 : view_mode=="wall_blocks" || view_mode=="wall_fit_sample" ? 480 : view_mode=="section" ? 600 : view_mode=="joint_detail" || view_mode=="mount_detail" ? 220 : view_mode=="washer" ? 40 : view_mode=="retainer_detail" ? 90 : view_mode=="fit_sample" ? 180 : view_mode=="retainer" ? 70 : overall_width*2.75;
