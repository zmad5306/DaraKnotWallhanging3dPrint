module fabric_reference() {
    translate([0, 0, fabric_back_z])
        linear_extrude(height = fabric_depth, convexity = 30)
            fabric_pattern();
    if(fabric_crossing_depth>0)
        translate([0,0,fabric_back_z+fabric_depth-.002])
            linear_extrude(height=fabric_crossing_depth+.002,convexity=30)
                fabric_crossings();
