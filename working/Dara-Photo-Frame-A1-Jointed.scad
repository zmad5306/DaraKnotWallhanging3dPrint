// WALL BLOCKS. All dimensions and coordinates here are finished millimetres.
// [frame section (0-based), installed XY, key Y offset, two local key X positions,
//  screw Y offset, two local screw X positions, clear strip centre Y].
// Positions clear all rabbets, 360-degree tab sweeps, M screws and lap domains.
wall_mounts = [[2,[-196,224],-8,[4,54],-10,[21,37],7],
               [4,[196,224],-8,[-54,14],-10,[-34,-6],7],
               [15,[-196,-224],8,[-14,52],10,[4,34],-7],
               [17,[196,-224],8,[-54,54],10,[-24,24],-7]];
wall_block_width = 140;
wall_block_height = 38;
wall_fastener_length = 12.7; // Same #6-19 x 1/2-inch pan-head screw as the photo tabs.
wall_fastener_seat = 3;
wall_fastener_pilot = 3.175; // Same nominal pilot as the photo and M attachments.
wall_fastener_clearance = 4;
wall_fastener_pilot_depth = wall_fastener_length-wall_fastener_seat+1;
wall_fastener_counterbore = 9; // Nominal 7 mm head plus driver clearance.
wall_key_width = 20;
wall_key_height = 10;
wall_key_projection = 3;
wall_keyhole_x = 51;
wall_keyhole_entry_y = -5;
wall_keyhole_seat_y = 6; // +Y is up: screw moves here as the frame lowers.
wall_keyhole_lip = 3; // Solid wall-facing skin captures the screw head.
wall_photo_head_height = 2.5; // Same nominal head envelope as photo_screw_preview_mm.
assert(wall_mount_index>=1 && wall_mount_index<=4 && floor(wall_mount_index)==wall_mount_index);
assert(wall_standoff>=photo_retainer_thickness+wall_photo_head_height+2,
       "Wall blocks must clear the photo tabs and screw heads by at least 2 mm");
assert(wall_key_clearance>=.1 && wall_key_clearance<=.4);
assert(wall_key_depth_clearance>=.15 && wall_key_depth_clearance<=.6);
assert(wall_screw_shaft_diameter>=3.5 && wall_screw_shaft_diameter<=5);
assert(wall_screw_head_diameter>=wall_screw_shaft_diameter+3 && wall_screw_head_diameter<=10);
assert(wall_screw_head_depth>=3 && wall_standoff-wall_keyhole_lip-wall_screw_head_depth>=2,
       "Keep at least 2 mm of solid block above the screw head channel");
assert(wall_mount_explode>=0);
assert(knot_depth*uniform_scale-wall_fastener_pilot_depth>=2.8-.000001);
assert(wall_standoff-wall_fastener_seat-wall_photo_head_height>=2,
       "Block screw heads must stay recessed below the strip face");

module wall_rounded_rect(w,h,r=1) {
    hull() for(x=[-w/2+r,w/2-r],y=[-h/2+r,h/2-r])
        translate([x,y]) circle(r=r,$fn=32);
}
module wall_keys_at(i) {
    m=wall_mounts[i];
    for(x=m[3]) translate([x,m[2],0]) children();
}
module wall_key() {
    // Small tip chamfer eases insertion without reducing the full-size root.
    translate([0,0,-.02]) linear_extrude(height=wall_key_projection-.5+.02)
        wall_rounded_rect(wall_key_width,wall_key_height);
    hull() {
        translate([0,0,wall_key_projection-.5]) linear_extrude(height=.01)
            wall_rounded_rect(wall_key_width,wall_key_height);
        translate([0,0,wall_key_projection-.01]) linear_extrude(height=.01)
            wall_rounded_rect(wall_key_width-.8,wall_key_height-.8,.6);
    }
}
module wall_slot() {
    c=wall_key_clearance;
    translate([0,0,-.02]) linear_extrude(height=wall_key_projection+wall_key_depth_clearance+.02)
        wall_rounded_rect(wall_key_width+2*c,wall_key_height+2*c,1+c);
    // Lead-in only at the rear mouth; no projections on a frame print.
    hull() {
        translate([0,0,-.02]) linear_extrude(height=.02)
            wall_rounded_rect(wall_key_width+2*c+.6,wall_key_height+2*c+.6,1+c+.3);
        translate([0,0,.4]) linear_extrude(height=.01)
            wall_rounded_rect(wall_key_width+2*c,wall_key_height+2*c,1+c);
    }
}
module wall_slot_pair(i) { wall_keys_at(i) wall_slot(); }
module wall_fasteners_at(i) {
    m=wall_mounts[i];
    for(x=m[5]) translate([x,m[4],0]) children();
}
module wall_fastener_pilot_cut() {
    translate([0,0,-.02]) cylinder(d=wall_fastener_pilot,h=wall_fastener_pilot_depth+.02,$fn=64);
}
module wall_frame_cuts(i) {
    wall_slot_pair(i);
    wall_fasteners_at(i) wall_fastener_pilot_cut();
}
module wall_fastener_block_cut() {
    // Counterbore opens from the wall face, leaving a 3 mm seat against the knot.
    translate([0,0,-.02]) cylinder(d=wall_fastener_counterbore,h=wall_standoff-wall_fastener_seat+.02,$fn=64);
    translate([0,0,wall_standoff-wall_fastener_seat-.01])
        cylinder(d=wall_fastener_clearance,h=wall_fastener_seat+.03,$fn=64);
}
module wall_fastener_preview(i,gap=0) {
    if($preview && show_mount_hardware) wall_fasteners_at(i)
        translate([0,0,-wall_fastener_seat-gap]) {
            %color([.55,.57,.6]) cylinder(d=3.5,h=wall_fastener_length,$fn=40);
            %color([.55,.57,.6]) translate([0,0,-wall_photo_head_height])
                cylinder(d=7,h=wall_photo_head_height,$fn=64);
        }
}
module wall_slots_for_section(i) {
    for(k=[0:3]) if(wall_mounts[k][0]==i)
        translate(concat(wall_mounts[k][1],[0])) wall_frame_cuts(k);
}
function has_wall_slots(i) = len([for(m=wall_mounts) if(m[0]==i) 1])>0;

module wall_head_channel_2d(d) {
    hull() for(y=[wall_keyhole_entry_y,wall_keyhole_seat_y])
        translate([wall_keyhole_x,y]) circle(d=d,$fn=64);
}
module wall_keyhole_cut() {
    // Rear opening: round head entry below a narrow vertical shaft slot.
    translate([wall_keyhole_x,wall_keyhole_entry_y,-.02])
        cylinder(d=wall_screw_head_diameter,h=wall_keyhole_lip+wall_screw_head_depth+.02,$fn=64);
    translate([0,0,-.02]) linear_extrude(height=wall_keyhole_lip+.04)
        wall_head_channel_2d(wall_screw_shaft_diameter);
    // Hidden wide channel permits the head to slide behind the retaining lip.
    translate([0,0,wall_keyhole_lip]) linear_extrude(height=wall_screw_head_depth)
        wall_head_channel_2d(wall_screw_head_diameter);
}
module wall_block_mm(i) {
    // Print with the flat wall face at Z=0, keys pointing up.
    // Clear strip rectangle: X=-65..30, Y=m[6]-10..m[6]+10 (95 x 20 mm).
    // Fastener recesses occupy the opposite long edge; the strip covers none.
    render(convexity=20) difference() {
        union() {
            linear_extrude(height=wall_standoff) wall_rounded_rect(wall_block_width,wall_block_height,2);
            translate([0,0,wall_standoff]) wall_keys_at(i) wall_key();
        }
        wall_keyhole_cut();
        wall_fasteners_at(i) wall_fastener_block_cut();
    }
}
module installed_wall_block(i,gap=0) {
    translate([0,0,-wall_standoff-gap]) wall_block_mm(i);
}
module wall_block_assembly(spread=0) {
    for(i=[0:3]) {
        m=wall_mounts[i];
        translate([m[1][0]+spread*m[1][0]/450,m[1][1]+spread*m[1][1]/450,0])
            union() {
                color(wall_block_colour) installed_wall_block(i,spread>0 ? spread+16 : 0);
                wall_fastener_preview(i,spread>0 ? spread+16 : 0);
            }
    }
}
module wall_blocks_print() {
    // Four separate blocks occupy 140 x 182 mm, all at Z=0 on one A1 bed.
    for(i=[0:3]) translate([0,72-i*48,0]) {
        color(wall_block_colour) wall_block_mm(i);
        if($preview && show_section_ids) %color("black") translate([-82,0,1])
            linear_extrude(height=.2) text(str("B",i+1),size=6,halign="center");
    }
    if($preview && show_plate_outline) a1_plate_outline();
}
module wall_fit_sample() {
    // Full-size matching block and slot coupon; keep both separate for printing.
    color(wall_block_colour) translate([0,-26,0]) wall_block_mm(wall_mount_index-1);
    color(knot_colour) translate([0,26,0]) difference() {
        linear_extrude(height=knot_depth*uniform_scale) wall_rounded_rect(wall_block_width,wall_block_height,2);
        wall_frame_cuts(wall_mount_index-1);
    }
}
module wall_mount_detail() {
    i=wall_mount_index-1; m=wall_mounts[i];
    color(knot_colour) render(convexity=50) intersection() {
        translate([-m[1][0],-m[1][1],0]) section_csg("frame",m[0]);
        translate([-75,-24,-.01]) cube([150,48,18]);
    }
    color(wall_block_colour) installed_wall_block(i,wall_mount_explode);
    wall_fastener_preview(i,wall_mount_explode);
}
module wall_keyhole_detail() {
    // Cut through the screw axis; exposes the retaining lip and closed head channel.
    color(wall_block_colour) render(convexity=20) intersection() {
        wall_block_mm(wall_mount_index-1);
        translate([wall_keyhole_x-15,-wall_block_height/2-1,-.02])
            cube([15,wall_block_height+2,wall_standoff+wall_key_projection+1]);
    }
}

// M ATTACHMENT. Values and coordinates below are finished millimetres.
// Records: [M section (0-based), knot section (0-based), XY].
// Locator records also store [secondary slot?, baseline angle].
mount_bearing_z = letter_back_z*uniform_scale;
screw_pilot_diameter = 3.175;
screw_pilot_depth = 8.7;
screw_clearance_diameter = 4;
screw_counterbore_diameter = 12;
screw_seat_skin = 4;
washer_thickness = 1;
screw_length = 12.7;
dowel_diameter = 4;
dowel_projection = 3;
dowel_hole_depth = 3.3;
assert(abs(mount_bearing_z-13.5)<.000001);
assert(letter_depth*uniform_scale-screw_pilot_depth>=1.8-.000001);
assert(screw_pilot_depth-(screw_length-washer_thickness-screw_seat_skin)>=1-.000001);
assert(dowel_clearance>=.1 && dowel_clearance<=.4);
assert(dowel_slot_relief>=.4 && dowel_slot_relief<=1.2);
assert(mount_index>=1 && mount_index<=len(screw_mounts) && floor(mount_index)==mount_index);

module mount_xy(xy) { translate([xy[0],xy[1],0]) children(); }

module M_pilot() {
    // Blind bore wholly inside the original M body; no geometry below its rear.
    translate([0,0,-.02]) cylinder(d=screw_pilot_diameter,h=screw_pilot_depth+.02,$fn=64);
}
module frame_screw_cuts() {
    seat_rear=mount_bearing_z-screw_seat_skin;
    // Rear counterbore and straight clearance through the full-height knot rail.
    translate([0,0,-.02]) cylinder(d=screw_counterbore_diameter,h=seat_rear+.02,$fn=96);
    translate([0,0,seat_rear-.01]) cylinder(d=screw_clearance_diameter,h=screw_seat_skin+.03,$fn=64);
}
module locating_dowel() {
    // Root directly in the full-height knot rail. No pedestal over the weave.
    top=letter_back_z*uniform_scale;
    translate([0,0,top-.02]) cylinder(d=dowel_diameter,h=dowel_projection-.5+.02,$fn=64);
    translate([0,0,top+dowel_projection-.5]) cylinder(d1=dowel_diameter,d2=dowel_diameter-.6,h=.5,$fn=64);
}
module locating_hole(secondary,angle) {
    rotate([0,0,angle]) {
        // Relief is axial only; the pair constrains both translation and rotation.
        hull() for(x=secondary ? [-dowel_slot_relief/2,dowel_slot_relief/2] : [0])
            translate([x,0,-.02]) cylinder(d=dowel_diameter+dowel_clearance,h=dowel_hole_depth+.02,$fn=64);
        hull() for(x=secondary ? [-dowel_slot_relief/2,dowel_slot_relief/2] : [0])
            translate([x,0,-.01]) cylinder(d1=dowel_diameter+dowel_clearance+.6,d2=dowel_diameter+dowel_clearance,h=.46,$fn=64);
    }
}
module section_evaluate() {
    // A close-up evaluates its entire boolean tree once. Nested F5 renders
    // would tessellate and re-import intermediate frame solids in OpenSCAD 2021.
    if($preview && (view_mode=="mount_detail" || view_mode=="wall_mount_detail" || view_mode=="joint_detail")) children();
    else render(convexity=50) children();
}
module section_csg(kind,i) {
    section_evaluate() difference() {
        union() {
            unmounted_section_csg(kind,i);
            if(kind=="frame") for(d=dowel_mounts) if(d[1]==i) mount_xy(d[2]) locating_dowel();
        }
        if(kind=="M") {
            for(m=screw_mounts) if(m[0]==i) mount_xy(m[2]) M_pilot();
            for(d=dowel_mounts) if(d[0]==i) mount_xy(d[2]) locating_hole(d[3],d[4]);
        } else {
            for(m=screw_mounts) if(m[1]==i) mount_xy(m[2]) frame_screw_cuts();
            wall_slots_for_section(i);
        }
    }
}
module screw_preview() {
    // Nominal envelope only, not a printable or specified thread/head model.
    // 12.7 mm under-head length; selected metal #6-19 pan-head screw.
    under_head=mount_bearing_z-screw_seat_skin-washer_thickness;
    translate([0,0,under_head]) cylinder(d=3.5,h=screw_length,$fn=40);
    translate([0,0,under_head-2.5]) cylinder(d=7,h=2.5,$fn=64);
}
module mount_hardware_preview() {
    // Background modifiers keep metal hardware and loose washers out of exports.
    if($preview && show_mount_hardware) for(m=screw_mounts) mount_xy(m[2]) {
        %color([.55,.57,.6]) screw_preview();
        %color([.85,.65,.25]) translate([0,0,mount_bearing_z-screw_seat_skin-washer_thickness]) tested_mount_washer();
    }
}
module mount_detail() {
    m=screw_mounts[mount_index-1];
    // Use native CSG for boolean close-ups; avoid re-booleaning preview meshes.
    translate([-m[2][0],-m[2][1],0]) {
        color(knot_colour) render(convexity=50) intersection() {
            section_csg("frame",m[1]);
            mount_xy(m[2]) translate([-22,mount_cutaway ? 0 : -22,-4]) cube([44,mount_cutaway ? 22 : 44,40]);
        }
        color(letter_colour) translate([0,0,letter_back_z*uniform_scale+mount_explode])
            render(convexity=50) intersection() {
                section_csg("M",m[0]);
                mount_xy(m[2]) translate([-22,mount_cutaway ? 0 : -22,-7]) cube([44,mount_cutaway ? 22 : 44,22]);
            }
        if($preview && show_mount_hardware) mount_xy(m[2]) {
            %color([.5,.53,.57]) screw_preview();
            %color([.85,.65,.25]) translate([0,0,mount_bearing_z-screw_seat_skin-washer_thickness]) tested_mount_washer();
        }
    }
}
module mount_map() {
    // Plan for inspection; mount labels are never added to the print geometry.
    color([.82,.85,.82]) linear_extrude(height=.05)
        scale([uniform_scale,uniform_scale]) fabric_outline();
    color([.61,.69,.64]) translate([0,0,.07]) linear_extrude(height=.02)
        scale([uniform_scale,uniform_scale]) knot_outline();
    color(letter_colour) translate([0,0,.1]) linear_extrude(height=.05)
        scale([uniform_scale,uniform_scale]) letter_outline();
    for(k=[0:len(screw_mounts)-1]) mount_xy(screw_mounts[k][2]) translate([0,0,.3]) {
        color("firebrick") linear_extrude(height=.05) circle(d=12,$fn=48);
        color("black") translate([8,0]) linear_extrude(height=.05) text(str("S",k+1),size=6);
    }
    for(k=[0:len(dowel_mounts)-1]) mount_xy(dowel_mounts[k][2]) translate([0,0,.4]) {
        color("steelblue") linear_extrude(height=.05) circle(d=4,$fn=32);
        color("black") translate([5,0]) linear_extrude(height=.05) text(str("D",k+1),size=5);
    }
}

