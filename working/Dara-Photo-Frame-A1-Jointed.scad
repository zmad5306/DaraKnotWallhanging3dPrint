frame_fabric_bounds = [[[-323.79822344769985,365.4935164274329],[-23.048152400550517,609.5449781017321]],[[23.904042267114267,395.11857791289077],[360.4708432361972,609.5999773273605]],[[-449.87081734592994,242.61178661842257],[-98.5132648383749,517.6070370723628]],[[-3.1028939641996764,116.42217857187204],[117.09655427753977,460.18415606923463]],[[92.60129066650855,147.69070485628825],[392.8154250338002,431.8333366380851]],[[-609.5999752351473,24.018208017791522],[-267.7946979077719,356.52655260089483]],[[-128.8775420481734,23.945378637311492],[21.6310977568873,431.6848105745046]],[[356.08382384480234,23.961772461770064],[609.5749927137527,388.3958942117638]],[[-485.71170685413875,7.753489319605808],[-86.65577016772697,219.22381802876666]],[[23.882534922175324,-2.913689715349044],[419.0057128433716,183.20834325478134]],[[-406.93702849870857,-200.08216826801367],[-83.69510982237809,32.741746913823164]],[[23.10475789111663,-163.89894590352648],[392.8315987053172,21.820336783306143]],[[-609.5779804505593,-359.03836898257674],[-375.37257866582667,-23.78717091402898]],[[-185.8279294472708,-393.0124106153817],[27.408013486739137,-23.922289559024378]],[[365.9673312700163,-361.27346393854833],[609.5999791763603,-23.245565996330352]],[[-427.0012913073577,-403.96347469527404],[-140.5571077368468,-159.9906321981591]],[[2.4197690494581545,-478.64650720835044],[134.26452271066657,-139.76096391614257]],[[106.54121191852109,-457.66500228512274],[400.65639767979525,-139.2490290347051]],[[-361.5061735958712,-609.599975824644],[-22.989396030118698,-364.96247324371114]],[[23.583987961272655,-609.4699727407511],[355.5039569260288,-422.60190786065453]]];
module fabric_crossings(bounds=[[-master_width/2,-master_width/2],[master_width/2,master_width/2]]) {
    if(fabric_style=="woven" && fabric_crossing_depth>0)
    intersection() {
        fabric_pattern();
        union() for(ix=[floor(bounds[0][0]/fabric_pitch)-1:ceil(bounds[1][0]/fabric_pitch)+1])
            for(iy=[floor(bounds[0][1]/fabric_pitch)-1:ceil(bounds[1][1]/fabric_pitch)+1])
                translate([ix*fabric_pitch,iy*fabric_pitch])
